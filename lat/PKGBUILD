_commit=d9e3dddffd68b456e4090a2d12053fb57624f3b0 #tag 1.6.1
pkgrel=1
pkgdesc="Loongson Architecture Translator"
arch=('loong64')
url="https://github.com/lat-opensource/lat"
license=('GPLv2+')
