build() {
  unset CXXFLAGS
  unset CFLAGS
  unset LDFLAGS
  cd lat
  ./latxbuild/build-release.sh
}

package() {
  cd lat
  cp -r pkg/lat-$pkgver/* ${pkgdir}/
}
