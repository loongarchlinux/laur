noextract=()
for _source in "${source[@]}"; do
  if [[ "$_source" =~ deb$ ]]; then
    noextract+=("${_source%%::*}")
  fi
done

# deb_file file source_dir target_dir
_pick_file() {
  local p="$1" f="$2" s="$3" d="$4" t
  t=${p%.deb}
  dpkg-deb -x ${srcdir}/${p} $t
  [ -d "${pkgdir}/$d" ] || mkdir -p "${pkgdir}/$d"
  if [ -L "$t/$s/$f" ]; then
    cp -a "$t/$s/$f" "${pkgdir}/$d"
    cp -p $t/$s/$(readlink "$t/$s/$f") "${pkgdir}/$d/$(readlink "$t/$s/$f")"
    chmod +x "${pkgdir}/$d/$(readlink "$t/$s/$f")"
  elif [ -d "$t/$s/$f" ]; then
    cp -rp "$t/$s/$f" "${pkgdir}/$d"
  else
    cp -p "$t/$s/$f" "${pkgdir}/$d"
  fi
  rm -r $t
}

# deb_file so_file target_dir
_pick_lib() {
  local p="$1" f="$2" d="$3"
  _pick_file $p $f "/usr/lib/loongarch64-linux-gnu" $d
}

prepare() {
  dpkg-deb -x ${srcdir}/firmware.deb _firmware
  cp _firmware/usr/share/doc/firmware-loongson-graphics/copyright License
  sed -i '1,/License: LOONGGPU-graphics-drivers/d' License
  sed -i '1,/License: LOONGGPU-graphics-drivers/d' License
  rm -r _firmware

  cd loonggpu-kernel-dkms
  patch -p1 -i ${srcdir}/0001-support-compressed-firmware-file-like-lg100_cp.bin.z.patch
}

package_loonggpu() {
  pkgdesc="Loongson GPU packages"
  arch=(any)
  depends=(loonggpu-dkms xf86-video-loonggpu)

  install -Dm644 ${srcdir}/License ${pkgdir}/usr/share/licenses/${pkgname}/License
}

package_linux-firmware-loonggpu() {
  pkgdesc="Firmware files for Linux - Firmware for Loongson GPUs"
  arch=(any)
  depends=(linux-firmware-whence)

  _pick_file firmware.deb lg100_cp.bin lib/firmware/loonggpu /usr/lib/firmware/loonggpu
  zstd --rm ${pkgdir}/usr/lib/firmware/loonggpu/lg100_cp.bin

  install -Dm644 ${srcdir}/License ${pkgdir}/usr/share/licenses/${pkgname}/License
}

package_loonggpu-dkms() {
  pkgdesc="Kernel module for LG-100/LG-200 video controller (DKMS)"
  arch=(any)
  depends=(dkms gcc14 linux-firmware-loonggpu)

  cd loonggpu-kernel-dkms
  mkdir -p "$pkgdir"/usr/src/loonggpu-$pkgver
  cp -RL * "$pkgdir"/usr/src/loonggpu-$pkgver

  mkdir -p ${pkgdir}/etc/modprobe.d
  cat >${pkgdir}/etc/modprobe.d/blacklist-loongson.conf <<EOF
blacklist loongson
install loongson /bin/true
EOF

  install -Dm644 ${srcdir}/License ${pkgdir}/usr/share/licenses/${pkgname}/License
}

package_mesa-loonggpu() {
  pkgdesc="Mesa libraries for Loongson GPUs"
  depends=(mesa mesa-loonggpu)

  _pick_lib loonggl.deb loonggpu /usr/lib
  _pick_lib loonggl.deb dri /usr/lib
  _pick_lib libedit.deb libedit.so.2 /usr/lib
  chmod +x ${pkgdir}/usr/lib/loonggpu/dri/gsgpu_dri.so

  _pick_lib libldrm.deb libldrm.so.1 /usr/lib
  _pick_lib loonggl.deb libEGL_loonggpu.so.0 /usr/lib
  _pick_lib loonggl.deb libGLX_loonggpu.so.0 /usr/lib
  _pick_lib gpucomp.deb libloong-gpucomp.so.1 /usr/lib
  ln -sf loonggpu/libglapidispatch.so.0 ${pkgdir}/usr/lib/libglapidispatch.so.0

  _pick_file loonggl.deb 60_loonggpu.json usr/share/glvnd/egl_vendor.d /usr/share/glvnd/egl_vendor.d/

  install -Dm644 ${srcdir}/License ${pkgdir}/usr/share/licenses/${pkgname}/License
}

package_xf86-video-loonggpu() {
  pkgdesc="Mesa libraries for Loongson GPUs"
  depends=(mesa-loonggpu)

  _pick_file xf86-video-loonggpu.deb loonggpu_drv.so /usr/lib/xorg/modules/drivers/ /usr/lib/xorg/modules/drivers/
  chmod +x ${pkgdir}/usr/lib/xorg/modules/drivers/loonggpu_drv.so

  install -Dm644 ${srcdir}/License ${pkgdir}/usr/share/licenses/${pkgname}/License
}
