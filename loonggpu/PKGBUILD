pkgname=('loonggpu' 'loonggpu-dkms' 'linux-firmware-loonggpu' 'mesa-loonggpu' 'xf86-video-loonggpu')
pkgbase=loonggpu
pkgver=1.0.1
pkgrel=1
debver=${pkgver}-alpha-lnd25.5
pkgdesc="Loongson GPU"
arch=('loong64')
url="https://loongnix.cn"
license=('custom')
options=(strip !debug emptydirs)
makedepends=('dpkg' 'git')
source=(
  "git+https://github.com/AOSC-Tracking/loonggpu-kernel-dkms.git#branch=aosc/v1.0.1-alpha-lnd25.5"
  "firmware.deb::https://pkg.loongnix.cn/loongnix/25/pool/main/f/firmware-loongson-graphics/firmware-loongson-graphics_${debver}_loong64.deb"
  "libldrm.deb::https://pkg.loongnix.cn/loongnix/25/pool/main/l/ldrm/libldrm_${debver}_loong64.deb"
  "gpucomp.deb::https://pkg.loongnix.cn/loongnix/25/pool/main/l/loong-gpucomp/libloong-gpucomp_${debver}_loong64.deb"
  "loonggl.deb::https://pkg.loongnix.cn/loongnix/25/pool/main/l/loonggl/loonggl_${debver}_loong64.deb"
  "libedit.deb::https://pkg.loongnix.cn/loongnix/25/pool/main/libe/libedit/libedit2_3.1-20240517-1_loong64.deb"
  "xf86-video-loonggpu.deb::https://pkg.loongnix.cn/loongnix/25/pool/main/x/xserver-xorg-video-loonggpu/xserver-xorg-video-loonggpu_${debver}_loong64.deb"
  "0001-support-compressed-firmware-file-like-lg100_cp.bin.z.patch"
)
sha256sums=('SKIP'
  '9fd7550b34b105eb0b6bbdf8750b242a542c75893ee67872738692c519074d0d'
  'bf4cbb3e43ff8fc184fae757b98f7005236cd107a351396bf1bfc0a27b81c6de'
