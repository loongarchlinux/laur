pkgname=liblol
pkgver=0.1.9
pkgrel=1
pkgdesc="Compatibility layer for running applications designed for Old-World LoongArch systems"
arch=(loong64)
url="https://github.com/AOSC-Dev/liblol"
license=(GPL-2.0-or-later LGPL-2.1-or-later)
depends=(la_ow_syscall-dkms glibc)
makedepends=(git gd python)

glibc_version=2.41
patchelf_version=0.18.0
libxcrypt_version=4.4.38

# see https://github.com/AOSC-Dev/aosc-os-abbs/blob/stable/runtime-emulation/liblol/
source=("https://ftp.gnu.org/gnu/glibc/glibc-${glibc_version}.tar.xz"
    "https://github.com/NixOS/patchelf/releases/download/${patchelf_version}/patchelf-${patchelf_version}.tar.gz"
    "https://github.com/besser82/libxcrypt/releases/download/v${libxcrypt_version}/libxcrypt-${libxcrypt_version}.tar.xz"
    "liblol.conf"
    )
glibc_patches=(
    0001-add-old-world-abi-compatibility.patch
    0002-add-sigset-ops.patch
    0003-add-signal-functions.patch
    0004-add-sigaction-ucontext-compat.patch
    0005-add-stubs-for-signal-related-io-funcs.patch
    0006-add-syscall-fallback-for-stat-at.patch
    0007-add-more-pthread-symbols.patch
    0008-remove-clone3-for-compatibility-with-qq.patch
    0009-prepend-trusted-dirs.patch
    0010-Add-___brk_addr-symbol.patch
    0011-siglist-errlist-add-compact-statements.patch
    )
patchelf_patches=(
    0001-add-remap-symvers.patch
    )
for i in ${glibc_patches[@]}; do
  source+=("https://github.com/AOSC-Dev/liblol/raw/refs/heads/master/autobuild/patches/glibc/$i")
done
for i in ${patchelf_patches[@]}; do
  source+=("https://github.com/AOSC-Dev/liblol/raw/refs/heads/master/autobuild/patches/patchelf/$i")
done

sha256sums=('a5a26b22f545d6b7d7b3dd828e11e428f24f4fac43c934fb071b6a7d0828e901'
            '64de10e4c6b8b8379db7e87f58030f336ea747c0515f381132e810dbf84a86e7'
            '80304b9c306ea799327f01d9a7549bdb28317789182631f1b54f4511b4206dd6'
